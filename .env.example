# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Optional legacy key name if your Supabase project still provides an anon key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=...
# RESEND_API_KEY=...

# Optional faculty-owned social channels. Set only verified official URLs.
NEXT_PUBLIC_FACULTY_INSTAGRAM_URL=
NEXT_PUBLIC_FACULTY_FACEBOOK_URL=
NEXT_PUBLIC_FACULTY_YOUTUBE_URL=
